# Copia este archivo como ".env" y llena los valores. ".env" nunca se sube a git.

# "demo" = datos de ejemplo en memoria, sin Google. "sheets" = tu libro real.
ORION_MODO=demo

# PIN de acceso a la app (solo dígitos). Obligatorio.
ORION_PIN=

# --- Solo para ORION_MODO=sheets ---
# ID del libro: lo que va entre /d/ y /edit en la URL de Google Sheets.
ORION_SHEET_ID=
# Ruta al JSON de la cuenta de servicio (guárdalo en backend/secrets/).
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json
# Alternativa para despliegues: el mismo JSON codificado en base64.
# GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# Opcional: clave para firmar sesiones. Si falta, se genera una al arrancar
# (las sesiones se cierran cada vez que reinicias el servidor).
# ORION_SECRETO=
